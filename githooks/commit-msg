#!/usr/bin/env bash
# commit-msg hooks. Order: advisory nudges first (never block), then the
# Agent-Session/Agent-Task trailer injection (never blocks), then the
# blocking term-neutrality gate, then the blocking self-improvement-edit
# gate (exec, terminates the hook).
set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
# Advisory (warn-only, exit 0): staged code without an accompanying test.
# See scripts/verify-tests-accompany-code.py + leaf tests-accompany-code.md.
python3 "$REPO_ROOT/scripts/verify-tests-accompany-code.py" "$1" || true
# Agent-Session/Agent-Task trailer: empty output for a human commit (no
# CLAUDE_CODE_SESSION_ID / no agentctl state). --if-exists doNothing makes
# this idempotent across amend/rebase re-runs. See scripts/agent_commit_trailer.py.
TRAILERS="$(python3 "$REPO_ROOT/scripts/agent_commit_trailer.py" 2>/dev/null || true)"
if [ -n "$TRAILERS" ]; then
  while IFS= read -r trailer_line; do
    if [ -n "$trailer_line" ]; then
      git interpret-trailers --in-place --if-exists doNothing --trailer "$trailer_line" "$1" || true
    fi
  done <<< "$TRAILERS"
fi
# Blocking gate: no org-internal term in the commit message itself (C1
# mechanism — a bad commit message can't be fixed post-landing without a
# forbidden history rewrite, so this is hard-blocking, unlike the advisory
# pre-write hook). Silent no-op on a machine with zero rulesets installed.
# --commit-msg keeps the scan off the `commit -v` diff below the scissors.
# Only exit 1 is a term hit; any other non-zero is the checker itself failing
# (exit 2, a crash, a missing file), which is surfaced but must not reject an
# otherwise-clean commit. See scripts/check-org-neutral.py + scripts/lib/term_ruleset.py.
set +e
python3 "$REPO_ROOT/scripts/check-org-neutral.py" --commit-msg "$1"
term_rc=$?
set -e
if [ "$term_rc" -eq 1 ]; then
  echo "commit-msg: org-internal term(s) found in the commit message (see" \
       "above) - rewrite the message WITHOUT quoting the removed term" \
       "verbatim. Do not bypass with --no-verify; if truly unavoidable," \
       "record why in the commit body and surface it to the coordinator." >&2
  exit 1
elif [ "$term_rc" -ne 0 ]; then
  echo "commit-msg: term check could not run (exit $term_rc) - the message was" \
       "NOT scanned. Commit allowed; fix the checker or the ruleset." >&2
fi
# Blocking gate: self-improvement skill edits. See verify-self-improvement-edit.py.
exec python3 "$REPO_ROOT/scripts/verify-self-improvement-edit.py" "$1"
