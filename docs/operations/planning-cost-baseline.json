{
 "formula": {
  "window": "a session is in the window when its first review record (plan_review, plan_pair_review, plan_review_compose, review_carried) falls in [window[0], window[1]) by UTC day",
  "counted_act": "a plan_review or plan_pair_review history event for which agentctl.cli._is_counted_review holds (lib.review_cycles.is_act); carried, override and composition records are not acts",
  "review_acts": "counted acts over the whole history",
  "admissible_cut": "acts_to_cut = counted acts before the first approve event; acts_after_cut = review_acts - acts_to_cut; a session never approved has no cut (null) and is counted in totals.sessions_never_approved",
  "plan_versions": "distinct plan_sha256 over submit_plan and replan events",
  "active_minutes": "state effort_actuals.active_minutes, the booked quantity",
  "cycle_minutes_to_cut": "sum of the rebuilt minutes of the review cycles of review-cost-calibrate.py (lib.review_cycles cycle cutting, scaled to active_minutes); null without a transcript",
  "spend": "claude-spawn-costs.jsonl rows with event spawn and ts in the window, grouped by kind: cost_usd is list price (telemetry under flat billing, not money), hours = sum(duration_ms) / 3.6e6",
  "axes": "R reachability, V controls, D format accounting, W wording, S safety and rollback; the label of one concern is taken from the dossier's classified-<session>.json as given (comp.py's rule: the first letter of the label; builds = label ends with * or is a bare R)",
  "builds": "concerns whose label changes what the plan builds",
  "counterfactual": "if only concerns that change what is built blocked approval, acts_to_cut shrinks by the share of such concerns: acts_to_cut * builds_share over the labelled sessions, an illustration under the labelling error, not a prediction",
  "hash": "sha256 of json.dumps(table, sort_keys=True, separators=(',', ':')) over the table's rows",
  "labelling_error": "labels are one reader's judgement, error about +-5 percentage points"
 },
