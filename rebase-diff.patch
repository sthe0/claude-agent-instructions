+
+    loaded = SessionState.from_dict(raw)
+    assert loaded.plan_stack[0].plugins == {}
+    assert loaded.plan_stack[0].plugins_archive == {}
+
+
+def test_subplan_json_roundtrip_preserves_nondefault_plugins(store):
