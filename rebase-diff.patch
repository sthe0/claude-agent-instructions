+    plugins.activate(parent, "experience")
+    parent.plugins["experience"]["searched"] = True
+    parent.plugins["experience"]["recorded"] = True
+    pre_push_plugins = {"experience": dict(parent.plugins["experience"])}
+    store.save(parent)
